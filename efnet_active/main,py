import torch
import torch.nn as nn
import cv2
import torchvision
from torchvision import transforms
import os

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

def build_model(model_type):
    if model_type == "efficientnet":
        weights = torchvision.models.EfficientNet_B0_Weights.IMAGENET1K_V1
        model = torchvision.models.efficientnet_b0(weights=weights)
        for param in model.features.parameters():
            param.requires_grad = False
        features = model.classifier[1].in_features
        model.classifier[1] = nn.Linear(features, 1)

    elif model_type == "alexnet":
        weights = torchvision.models.AlexNet_Weights.IMAGENET1K_V1
        model = torchvision.models.alexnet(weights=weights)
        for param in model.features.parameters():
            param.requires_grad = False
        features = model.classifier[6].in_features
        model.classifier[6] = nn.Linear(features, 1)
    return model.to(device)


transform = transforms.Compose([
    transforms.ToPILImage(),
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406],
                         std=[0.229, 0.224, 0.225])
])


def predict(model, frame):
    model.eval()
    tensor = transform(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
    tensor = tensor.unsqueeze(0).to(device)
    with torch.no_grad():
        predicted = model(tensor).squeeze()
        prob = torch.sigmoid(predicted).item()
    label = "person" if prob > 0.5 else "no_person"
    return label, prob

def main():
    model_eff = build_model("efficientnet")
    model_eff.load_state_dict(torch.load("effnet.pth", map_location=device, weights_only=True))
    model_eff.eval()

    model_alex = build_model("alexnet")
    model_alex.load_state_dict(torch.load("alexnet.pth", map_location=device, weights_only=True))
    model_alex.eval()

    cap = cv2.VideoCapture(0)

    while True:
        ret, frame = cap.read()
        if not ret: break

        label_eff, conf_eff = predict(model_eff, frame)
        label_alex, conf_alex = predict(model_alex, frame)

        cv2.putText(frame, f"EffNet: {label_eff} ({conf_eff:.2f})", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8,
                    (0, 255, 0), 2)
        cv2.putText(frame, f"AlexNet: {label_alex} ({conf_alex:.2f})", (10, 70), cv2.FONT_HERSHEY_SIMPLEX, 0.8,
                    (255, 0, 0), 2)

        cv2.imshow("Demonstration", frame)
        if cv2.waitKey(1) & 0xFF == ord("q"): break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
